# Run scripts/setup.sh to generate secrets. Do not use example values.
ENCRYPTION_KEY=
INTERNAL_KEY=
APP_ORIGIN=http://localhost:5173
HELIX_URL=http://127.0.0.1:6996
# Cloud HelixDB GA (shared gateway) — set both; reads use writer-only routing:
# HELIX_URL=https://db-us-east-1.helix-db.com
# HELIX_API_KEY=
# HELIX_DATABASE_ID=
EXECUTOR_URL=http://127.0.0.1:3002
OLLAMA_URL=http://127.0.0.1:11434
DATA_DIR=.data
# Compose: the browser origin. There is no sign-in, so keep it on this computer.
PUBLIC_ORIGIN=http://localhost:3001
PUBLIC_PORT=3001
# MODEL_ENDPOINT=http://host.docker.internal:11434
# Optional provider sign-in. Register each integration and its workspace callback URL.
# See docs/HOSTING.md. Leave blank to use provider API keys or direct connections.
NEON_CLIENT_ID=
NEON_CLIENT_SECRET=
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
PLANETSCALE_CLIENT_ID=
PLANETSCALE_CLIENT_SECRET=
